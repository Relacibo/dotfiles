#!/usr/bin/env bash
# nsync — notes bisync wrapper (PC/Laptop <-> ovilava webdav)
# Aufruf: nsync [rclone-bisync-flags]   z.B. nsync --resync | nsync --dry-run
#         nsync install                 Pass-Datei + Timer-Intervall (Drop-In) + Timer aktivieren
# Das Remote wird per Umgebungsvariable definiert: keine Secrets in der Config,
# kein Eintrag in rclone.conf — Config + Script sind repo-syncbar.
CONF="${NSYNC_CONF:-$HOME/.config/nsync/nsync.conf}"
# shellcheck disable=SC1090
[ -f "$CONF" ] && . "$CONF"

LOCAL="${LOCAL:-$HOME/notes}"
REMOTE_NAME="${REMOTE_NAME:-ovilava-notes}"
REMOTE_TYPE="${REMOTE_TYPE:-webdav}"
REMOTE_URL="${REMOTE_URL:?REMOTE_URL fehlt in ${CONF}}"
REMOTE_VENDOR="${REMOTE_VENDOR:-owncloud}"
REMOTE_USER="${REMOTE_USER:?REMOTE_USER fehlt in ${CONF}}"
PASS_FILE="${PASS_FILE:-$HOME/.config/nsync/ovilava-notes.pass}"
SUBDIR="${SUBDIR:-notizen}"
LOG="${LOG:-$HOME/.local/state/nsync.log}"
FILTERS="${FILTERS:-$HOME/.config/nsync/filters.txt}"
RCLONE="${RCLONE:-rclone}"
GIT_DIR="${GIT_DIR:-$HOME/notes}"
INTERVAL="${INTERVAL:-}"

do_install() {
  command -v "$RCLONE" >/dev/null 2>&1 || { echo "nsync install: rclone nicht gefunden (dnf/pacman install rclone)" >&2; return 1; }
  mkdir -p "$(dirname "$PASS_FILE")"
  if [ -s "$PASS_FILE" ]; then
    echo "nsync install: Passwortdatei $PASS_FILE vorhanden — unberührt gelassen."
  elif [ -t 0 ]; then
    printf 'WebDAV-Passwort für %s (%s): ' "$REMOTE_USER" "$REMOTE_URL" >&2
    read -r -s PW; echo >&2
    [ -n "$PW" ] || { echo "nsync install: leeres Passwort — Abbruch" >&2; return 1; }
    "$RCLONE" obscure "$PW" > "$PASS_FILE" && chmod 600 "$PASS_FILE" \
      && echo "nsync install: → $PASS_FILE angelegt (obscured, chmod 600)"
  else
    echo "nsync install: $PASS_FILE fehlt und stdin ist kein TTY — Passwort kann nicht abgefragt werden." >&2
    echo "  Manuell: read -s PW && $RCLONE obscure \"\$PW\" > $PASS_FILE && chmod 600 $PASS_FILE" >&2
    return 1
  fi
  if [ -n "$INTERVAL" ]; then
    mkdir -p "$HOME/.config/systemd/user/nsync.timer.d"
    printf '[Timer]\nOnCalendar=%s\n' "$INTERVAL" > "$HOME/.config/systemd/user/nsync.timer.d/override.conf"
    echo "nsync install: → Timer-Intervall '$INTERVAL' als systemd-Drop-In gesetzt (maschinenlokal, nicht im Repo)"
  fi
  systemctl --user daemon-reload
  if systemctl --user enable --now nsync.timer 2>/dev/null; then
    echo "nsync install: → Timer aktiv"
  else
    echo "nsync install: → Timer-Unit nicht gefunden (erst dotfiles stowen) — Sync läuft manuell: nsync" >&2
  fi
  echo "nsync install: fertig. Erster Abgleich auf neuem Gerät: nsync --resync"
}

case "${1:-}" in
  install) shift; do_install; exit $? ;;
esac

[ -r "$PASS_FILE" ] || { echo "nsync: Passwortdatei $PASS_FILE fehlt (einmal: nsync install) oder unlesbar" >&2; exit 9; }
PASS=$(cat "$PASS_FILE")
NAME_UP="${REMOTE_NAME^^}"
REMOTE="${REMOTE_NAME}:${SUBDIR}"

mkdir -p "$(dirname "$LOG")"
exec >> "$LOG" 2>&1
echo "=== $(date '+%F %T') nsync start ($LOCAL <-> $REMOTE) $*"

env \
  "RCLONE_CONFIG_${NAME_UP}_TYPE=${REMOTE_TYPE}" \
  "RCLONE_CONFIG_${NAME_UP}_URL=${REMOTE_URL}" \
  "RCLONE_CONFIG_${NAME_UP}_VENDOR=${REMOTE_VENDOR}" \
  "RCLONE_CONFIG_${NAME_UP}_USER=${REMOTE_USER}" \
  "RCLONE_CONFIG_${NAME_UP}_PASS=${PASS}" \
  "$RCLONE" bisync "$LOCAL" "$REMOTE" \
  --filters-file "$FILTERS" \
  --conflict-suffix sync-conflict \
  --resilient --max-lock 2m "$@"
RC=$?
echo "=== exit $RC"

if [ $RC -eq 0 ] && [ "${NSYNC_NO_GIT:-0}" != "1" ] && [ -d "$GIT_DIR/.git" ]; then
  git -C "$GIT_DIR" add -A
  if ! git -C "$GIT_DIR" diff --cached --quiet; then
    git -C "$GIT_DIR" commit -q -m "nsync: auto-commit nach bisync"
    echo "=== git auto-commit"
  fi
fi
exit $RC
